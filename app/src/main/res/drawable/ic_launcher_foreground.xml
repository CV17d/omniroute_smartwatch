<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon foreground: start point, curved route and destination pin.
     Kept inside the 66dp safe zone so circular (Wear OS) masks don't clip it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="57"
        android:pivotY="51"
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:translateX="-3"
        android:translateY="3">

        <!-- Route -->
        <path
            android:pathData="M41,67 C52,67 50,57 61,57 L66,57"
            android:strokeColor="#E6FFFFFF"
            android:strokeWidth="4.5"
            android:strokeLineCap="round" />

        <!-- Start point (ring) -->
        <path
            android:pathData="M36.2,67 a4.8,4.8 0 1,0 9.6,0 a4.8,4.8 0 1,0 -9.6,0"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.6" />

        <!-- Destination pin -->
        <path
            android:pathData="M69,57 C69,57 59.5,47.5 59.5,39 A9.5,9.5 0 1,1 78.5,39 C78.5,47.5 69,57 69,57 Z"
            android:fillColor="#FFFFFFFF" />

        <!-- Pin accent -->
        <path
            android:pathData="M65.2,39 a3.8,3.8 0 1,0 7.6,0 a3.8,3.8 0 1,0 -7.6,0"
            android:fillColor="#FFF59E0B" />
    </group>
</vector>
